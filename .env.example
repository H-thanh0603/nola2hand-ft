# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nola2hand?schema=public"

# JWT
JWT_SECRET="thay-bang-chuoi-bi-mat-cua-ban"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# Frontend (CORS)
CLIENT_URL="http://localhost:5173"

# URL mở link email và ảnh upload
APP_URL="http://localhost:4000"
# Upload lưu trong uploads/; cần giữ thư mục này khi triển khai.

# Email thật qua Resend. Thiếu cấu hình: development lưu thư trong .local/mail/.
# Production cần cả hai giá trị và domain gửi đã được xác minh.
# RESEND_API_KEY=
# MAIL_FROM="Nola2Hand <no-reply@your-domain.com>"

# AI tùy chọn: chọn model hỗ trợ Responses API và JSON output.
# Thiếu cấu hình: tìm kiếm và phân tích đánh giá dùng quy tắc cục bộ.
# OPENAI_API_KEY=
# OPENAI_MODEL=
AI_REVIEW_ANALYSIS="false"

# Đăng nhập bằng Google: tạo OAuth Client tại https://console.cloud.google.com/apis/credentials
# (loại Web application), thêm http://localhost:4000 vào Authorized JavaScript origins
# GOOGLE_CLIENT_ID=
